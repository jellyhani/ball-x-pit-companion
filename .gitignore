# 가상 환경·캐시
.venv/
__pycache__/
*.pyc

# 플러그인 빌드 산출물 (vendor/bepinex 의 사본은 커밋한다: 자동 설치용)
tools/bepinex/*/bin/
tools/bepinex/*/obj/
tools/bepinex/pending_install.log

# 개발 중 임시 결과물
scratch/

# 게임에서 추출한 자료·서드파티 파일은 저장소에 넣지 않는다 (setup.ps1 이 사용자 PC 에서 만든다)
data/icons/
data/portraits/
data/ocr/
data/game_text_ko.json
data/icon_manifest.json
data/*_db.json
vendor/bepinex/*.zip
tests/fixtures/*.png

# exe 빌드 결과물 (GitHub Releases 로 배포)
build/
dist/
